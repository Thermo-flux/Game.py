print ("Welcome to Type-Racer!")
Name = input ("Please Enter Your Name And Press Enter:-")
print(f"Hi {Name}!")
word_length = int(input("Please enter word length:-"))
import string 
import random
import time  
while True :
    Word = "".join (random.choices (string.ascii_letters, k=word_length )) 
    print (f"here you go!:- {Word}")
    input ("press enter when ready to type.")
    start_time = time.time()
    typed_word = input("GO!:-")
    end_time = time.time()
    total_time = end_time - start_time
    if typed_word == Word :
        print ("PERFECT MATCH! Good Job!")
        print (f"You Typed it in {total_time}Seconds!")
    else :
        user_answer = input ("OOPS! Wrong Word Entered! press y to Retry!")
        if user_answer.lower () != "y" :
            break

        
        

        
        

        


      
  



 


   



